{
  "expo": {
    "name": "myBody",
    "slug": "mybody",
    "version": "0.6.0",
    "description": "离线记录身体指标，直观看见每一次变化",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2F2F7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "package": "com.mybody.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "allowBackup": false,
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择身体变化照片",
          "cameraPermission": "拍摄身体变化照片",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withMyBodyBuild.cjs",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-mark.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "image": "./assets/brand-mark-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ]
  }
}
